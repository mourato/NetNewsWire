# Public project facts generated by swift-project-setup.
# Replace the @...@ markers. Machine-local values (signing identity, team,
# notary profile) go in environment variables, never in this file.
#
# NetNewsWire is a two-platform project. This surface drives the macOS app,
# which is the platform make run/package/dmg/notarize support. The iOS target is
# driven by scripts/ios.sh (see `make build-ios`), which may need a different
# Xcode than the default one.
CONTAINER_KIND="project"
PROJECT_PATH="NetNewsWire.xcodeproj"
SCHEME="NetNewsWire"
PLATFORM="macOS"
DESTINATION="platform=macOS,arch=arm64"
APP_NAME="NetNewsWire"
DERIVED_DATA=".xcode-build"
DIST_DIR="dist"
# Leave both empty when the project has no tests.
TEST_SCHEME="NetNewsWire"
TEST_DESTINATION="platform=macOS,arch=arm64"
# Only when CONTAINER_KIND is workspace: the .xcodeproj that owns the app versions.
VERSION_PROJECT_PATH=""
# NetNewsWire keeps MARKETING_VERSION/CURRENT_PROJECT_VERSION in xcconfig, not
# in project.pbxproj, so `make version` edits these files instead. Every file
# listed must hold the same value; version.sh refuses to guess when they differ.
VERSION_XCCONFIG_FILES="xcconfig/common/NetNewsWire_version.xcconfig xcconfig/common/NetNewsWire_mac_target_common.xcconfig xcconfig/common/NetNewsWire_ios_target_common.xcconfig"

# iOS target. Driven by scripts/ios.sh, which is separate from the macOS surface
# above because iOS needs a matching simulator runtime. Set IOS_DEVELOPER_DIR to
# the Xcode that provides it; leave it unset to use the default toolchain.
IOS_SCHEME="NetNewsWire-iOS"
IOS_DESTINATION="platform=iOS Simulator,name=iPhone 17"
IOS_DERIVED_DATA=".xcode-build/ios"
